{
  "name": "experimental-domain-syntax",
  "displayName": "Premise Syntax",
  "version": "0.0.1",
  "description": "Syntax highlighting for the experimental Premise language.",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "local-research",
  "contributes": {
    "languages": [
      {
        "id": "experimental-domain",
        "aliases": [
          "Premise (experimental)"
        ],
        "extensions": [
          ".domain"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "experimental-domain",
        "scopeName": "source.experimental-domain",
        "path": "./domain.tmLanguage.json"
      }
    ]
  },
  "engines": {
    "vscode": "^1.80.0"
  }
}
