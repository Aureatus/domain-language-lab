{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "application/snapshot.ts",
    "application/submission.ts",
    "application/view-records.ts",
    "semantic/v2/types.test.mts"
  ]
}
