{
  "name": "premise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": { "node": "^22.18.0 || ^24.11.0 || >=26.0.0" },
  "scripts": {
    "knip": "knip",
    "lint": "vp lint -c .oxlintrc.json",
    "typecheck": "effect-language-service patch && tsc -p tsconfig.json && effect-tsgo tsc@7.0.2 -p tsconfig.json",
    "test": "node --test prototype/*.test.ts live/*.test.ts semantic/*.test.ts semantic/v2/*.test.ts inventory/*.test.ts inventory/v2/*.test.ts adapters/effect/*.test.ts adapters/lean/*.test.ts adapters/exact/test.ts workspace/*.test.ts application/*.test.ts leave/*.test.ts syntax/*.test.ts",
    "syntax:check": "node syntax/cli.ts check",
    "syntax:lint": "node syntax/lint.ts",
    "syntax:reader:test": "node syntax/reader-browser-test.ts",
    "syntax:serve": "node syntax/cli.ts serve",
    "syntax:test": "node --test syntax/*.test.ts",
    "syntax:browser": "node syntax/browser-test.ts",
    "application:count": "node application/count.ts",
    "application:test": "node application/browser-test.ts",
    "application:submission:test": "node application/submission-browser-test.ts",
    "inspect:action": "node application/inspect-action.ts",
    "check:interactions": "node application/check-interactions.ts",
    "application:review:test": "node application/action-review-browser-test.ts",
    "application:cli": "node application/cli.ts",
    "application:cli:test": "node application/cli-browser-test.ts",
    "syntax:reader": "node syntax/highlight.ts",
    "leave": "node leave/server.ts",
    "leave:cli": "node application/cli.ts --view leave/cli.domain",
    "leave:test": "node leave/browser-test.ts",
    "leave:video": "node leave/video.ts",
    "workspace": "node workspace/server.ts",
    "workspace:test": "node workspace/browser-test.ts",
    "workspace:video": "node workspace/video.ts",
    "durable:generated": "node inventory/v2/generated.ts artifacts/durable-generated-report.json",
    "inventory:durable": "node inventory/v2/demo.ts",
    "test:durable": "node --test adapters/effect/durable*.test.ts inventory/v2/*.test.ts semantic/v2/*.test.ts",
    "adapters:install": "pnpm install --frozen-lockfile",
    "inventory:build": "node inventory/build.ts",
    "inventory:test": "node inventory/browser-test.ts",
    "inventory:video": "node inventory/video.ts",
    "proof:generated": "node adapters/lean/check.ts",
    "proof:inventory": "node adapters/lean/inventory.ts artifacts/inventory-proof",
    "demo": "node prototype/demo.ts",
    "properties": "node prototype/property.ts",
    "proof": "sh proof/run.sh",
    "workbench": "node workbench/build.ts",
    "test:browser": "node workbench/test-browser.ts",
    "showcase": "pnpm test && pnpm demo && pnpm properties && pnpm proof && pnpm workbench",
    "live:build": "node live/build.ts",
    "live:test": "node live/browser-test.ts",
    "live:video": "node live/record-demo.ts",
    "live:generated": "node live/generated.ts"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/tsgo": "0.73.4",
    "@types/node": "24.19.4",
    "axe-core": "4.11.1",
    "knip": "6.46.1",
    "playwright": "1.65.0",
    "typescript": "5.9.3",
    "vite-plus": "1.8.0"
  }
}
