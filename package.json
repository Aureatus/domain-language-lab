{
  "name": "unnamed-language-experiment",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "test": "node --test prototype/*.test.ts live/*.test.mjs semantic/*.test.mjs semantic/v2/*.test.mjs inventory/*.test.mjs inventory/v2/*.test.mjs adapters/effect/*.test.mjs adapters/lean/*.test.mjs adapters/exact/test.mjs workspace/*.test.mjs application/*.test.mjs leave/*.test.mjs syntax/*.test.mjs",
    "syntax:check": "node syntax/cli.mjs check",
    "syntax:lint": "node syntax/lint.mjs",
    "syntax:reader:test": "node syntax/reader-browser-test.mjs",
    "syntax:serve": "node syntax/cli.mjs serve",
    "syntax:test": "node --test syntax/*.test.mjs",
    "syntax:browser": "node syntax/browser-test.mjs",
    "application:count": "node application/count.mjs",
    "application:test": "node application/browser-test.mjs",
    "application:submission:test": "node application/submission-browser-test.mjs",
    "inspect:action": "node application/inspect-action.mjs",
    "check:interactions": "node application/check-interactions.mjs",
    "application:review:test": "node application/action-review-browser-test.mjs",
    "application:cli": "node application/cli.mjs",
    "application:cli:test": "node application/cli-browser-test.mjs",
    "syntax:reader": "node syntax/highlight.mjs",
    "leave": "node leave/server.mjs",
    "leave:cli": "node application/cli.mjs --view leave/cli.domain",
    "leave:test": "node leave/browser-test.mjs",
    "leave:video": "node leave/video.mjs",
    "workspace": "node workspace/server.mjs",
    "workspace:test": "node workspace/browser-test.mjs",
    "workspace:video": "node workspace/video.mjs",
    "durable:generated": "node inventory/v2/generated.mjs artifacts/durable-generated-report.json",
    "inventory:durable": "node inventory/v2/demo.mjs",
    "test:durable": "node --test adapters/effect/durable*.test.mjs inventory/v2/*.test.mjs semantic/v2/*.test.mjs",
    "adapters:install": "npm ci --prefix adapters/effect",
    "inventory:build": "node inventory/build.mjs",
    "inventory:test": "node inventory/browser-test.mjs",
    "inventory:video": "node inventory/video.mjs",
    "proof:generated": "node adapters/lean/check.mjs",
    "proof:inventory": "node adapters/lean/inventory.mjs artifacts/inventory-proof",
    "demo": "node prototype/demo.ts",
    "properties": "node prototype/property.ts",
    "proof": "sh proof/run.sh",
    "workbench": "node workbench/build.ts",
    "test:browser": "node workbench/test-browser.mjs",
    "showcase": "npm test && npm run demo && npm run properties && npm run proof && npm run workbench",
    "live:build": "node live/build.mjs",
    "live:test": "node live/browser-test.mjs",
    "live:video": "node live/record-demo.mjs",
    "live:generated": "node live/generated.mjs"
  }
}
