module "time-away-browser" view
import "./time-away.domain"
import "./demo.domain"
use "time-away"

application
  title "Time away"
  eyebrow "A little room for what matters"
  subtitle "Plan a break. We’ll take care of the paperwork."
  scope "Local identity simulation · Monday–Friday only · no holiday calendar"
  actor maya label "Maya Chen · employee" name "Maya Chen"
  actor leo label "Leo Martin · employee" name "Leo Martin"
  actor sam label "Sam Rivera · manager" name "Sam Rivera"
  present "leave.request"
    label "Request time off"
    description "Choose your dates. Your balance changes only when the request is completed."
    field employeeId
      bind actor
    end
    field leaveId
      bind "operation-id"
    end
    field start
      label "First day"
      default "2026-11-20"
    end
    field end
      label "Last day"
      default "2026-11-20"
    end
    field days
      label "Weekdays"
    end
    adapter "utc-weekday-range/v1"
      start start
      end end
      output days
    end
  end
  present "settings.change"
    label "Save approval rule"
    description "Requests at or above this many weekdays need approval. Shorter breaks are approved automatically."
    field threshold
      label "Approval needed from (days)"
      default from settings key "leave-rule" field threshold
    end
  end
  view summary employee key "$actor" label "Your time to recharge"
    field name label "Team member"
    field balance label "Days remaining"
  end
  view summary settings key "leave-rule" label "The current rule"
    field threshold label "Days or more need approval"
  end
  view list leave label "Saved time off"
    field owner label "Team member"
    field start label "First day" format date
    field end label "Last day" format date
    field days label "Weekdays"
    field status label "Status"
  end
end
